# --- Runtime ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001

# --- CORS (comma-separated; "*" allowed in development) ---
ALLOWED_ORIGINS=http://localhost:3000,https://www.divyadarshan360.com

# --- Razorpay (https://dashboard.razorpay.com) ---
# Use test keys (rzp_test_*) during development.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Webhook secret from Razorpay Dashboard -> Settings -> Webhooks -> Add new webhook.
# Different from the API key secret. Required for /razorpay/webhook to accept events.
# RAZORPAY_WEBHOOK_SECRET=

# FIREBASE_CREDENTIALS_JSON=

# --- Receipt prefix used when creating Razorpay orders ---
RECEIPT_PREFIX=DD360
