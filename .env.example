# --- Runtime ---
# NOTE: do NOT set PORT or HOST in .env when deploying to Firebase Functions.
# PORT is reserved by the runtime (Cloud Run picks it). HOST/PORT only affect
# run_local.py and have sensible defaults — leave them out.
ENVIRONMENT=development

# --- CORS (comma-separated; "*" allowed in development) ---
ALLOWED_ORIGINS=http://localhost:3000,https://www.divyadarshan360.com

# --- Razorpay (https://dashboard.razorpay.com) ---
# Use test keys (rzp_test_*) during development.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Webhook secret from Razorpay Dashboard -> Settings -> Webhooks -> Add new webhook.
# Different from the API key secret. Required for /razorpay/webhook to accept events.
# RAZORPAY_WEBHOOK_SECRET=

# --- Service-account credentials (local dev only) ---
# On Firebase Functions / Cloud Run, leave these blank — Application Default
# Credentials handle Firestore access automatically. Names cannot start with
# FIREBASE_ (reserved) so we use SERVICE_ACCOUNT_*.
# SERVICE_ACCOUNT_PATH=./divyadarshanweb-3c2d7-firebase-adminsdk-fbsvc-b8f0850f4b.json
# SERVICE_ACCOUNT_JSON=

# --- Receipt prefix used when creating Razorpay orders ---
RECEIPT_PREFIX=DD360

# --- Gmail SMTP (transactional email) ---
# Gmail needs a 16-char App Password (NOT your account password).
# 1. Enable 2-Step Verification at https://myaccount.google.com/security
# 2. Generate one at https://myaccount.google.com/apppasswords
# 3. Paste it below (spaces optional).
# SMTP_USERNAME=team.divyadarshan@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM_NAME=Divya Darshan 360
# SMTP_SERVER and SMTP_PORT default to smtp.gmail.com:465 (SSL).

# --- WhatsApp Cloud API (Meta Graph) ---
# https://developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Phone Number ID: shown on the API Setup page (NOT the phone number itself).
# Access Token: generate a permanent System User token via Business Manager,
# OR use the temporary 24-hour token from API Setup for first tests.
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=1234567890123456
# WHATSAPP_TEMPLATE_NAME=order_confirmation
# WHATSAPP_TEMPLATE_LANGUAGE=en

# --- SMS Striker (kept for reference; not wired into the receipt flow) ---
# SMS_STRIKER_USERNAME=
# SMS_STRIKER_PASSWORD=
# SMS_STRIKER_CHANNEL=
# SMS_STRIKER_ORDER_TEMPLATE_ID=

# --- Where customers can reach you (shown on receipts) ---
# MERCHANT_SUPPORT_EMAIL=connect@youtellme.ai
# MERCHANT_SUPPORT_PHONE=+91 90499 21850
